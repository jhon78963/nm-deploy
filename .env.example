# =============================================================================
# nm-deploy/.env.example — variables del stack unificado
# Copia a .env y completa antes de docker compose up.
# =============================================================================

# ── Entorno de despliegue ─────────────────────────────────────────────────────
# local      → Docker en tu máquina (localhost:3015, :8080, :3000)
# production → VPS con dominios reales
DEPLOY_ENV=local

# ── Storefront (nm-ecommerce) ─────────────────────────────────────────────────
STORE_WAREHOUSE_ID=

# URLs públicas (browser + OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3015

# Admin Angular build: docker (local) | production (VPS)
NG_CONFIGURATION=docker

# CORS + URLs públicas del backend (gateway, auth, ecommerce-service)
FRONTEND_URL=http://localhost:8080
ECOMMERCE_STORE_URL=http://localhost:3015
CORS_ORIGINS=http://localhost:3015,http://localhost:8080,http://localhost:4200

NEXT_PUBLIC_WHATSAPP_NUMBER=51915213408

# Google reCAPTCHA v3 (site key pública — va embebida en el build de Next.js)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Culqi Checkout (pk_test_ en local, pk_live_ en VPS)
NEXT_PUBLIC_CULQI_PUBLIC_KEY=

# Puertos expuestos en el host (acceso directo sin reverse-proxy)
STOREFRONT_PORT=3015
ADMIN_PORT=8080
HTTP_PORT=80

# ── Observabilidad (profile observability) ────────────────────────────────────
# Grafana local: http://localhost:3010
# Prod con edge: https://grafana.novedadesmaritex.net.pe
GRAFANA_PORT=3010
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3010
# GRAFANA_ROOT_URL=https://grafana.novedadesmaritex.net.pe
LOKI_PORT=3100

# OAuth Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Token opcional para APIs protegidas del gateway
API_ACCESS_TOKEN=

# Revalidación on-demand de caché Next.js (header, etc.) al guardar en admin
REVALIDATE_SECRET=
# STOREFRONT_REVALIDATE_URL=http://storefront:3015/api/revalidate

# ETL Laravel → Prisma (solo migración inicial con backup nm_db)
RUN_LARAVEL_ETL=false

# ── Producción (VPS) ──────────────────────────────────────────────────────────
# DEPLOY_ENV=production
# NG_CONFIGURATION=production
# NEXT_PUBLIC_APP_URL=https://novedadesmaritex.net.pe
# FRONTEND_URL=https://app.novedadesmaritex.net.pe
# ECOMMERCE_STORE_URL=https://novedadesmaritex.net.pe
# CORS_ORIGINS=https://app.novedadesmaritex.net.pe,https://novedadesmaritex.net.pe,https://www.novedadesmaritex.net.pe
#
# También en ../nm-backend/.env del servidor:
#   NODE_ENV=production
#   STORAGE_PUBLIC_BASE_URL=https://api.novedadesmaritex.net.pe/api/v1/storage/files
